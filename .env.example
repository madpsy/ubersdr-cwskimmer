# CW Skimmer Docker Configuration
# Copy this file to .env and customize the values

# SkimSrv License
# To run SkimSrv as registered, export the Armadillo license blobs from a licensed
# Windows installation and place the .reg file(s) in the licenses/ directory.
# All *.reg files in that directory are automatically imported into Wine on startup.
# The licenses/ directory is bind-mounted read-only into the container.
# The licenses/ directory is gitignored so your license is never accidentally committed.

# License Export
# When true, a background watcher exports the Armadillo license blobs back to ./licenses/
# after you register SkimSrv via the GUI inside the container. This lets the license
# persist across container recreations.
# WARNING: Leaving this enabled will also re-import RttySkimServ trial state on every
# restart, causing it to remember how many trial days remain rather than resetting.
# Only enable this temporarily when registering SkimSrv via the GUI.
# Default: false
LICENSE_EXPORT_ENABLED=false

# Station Configuration
CALLSIGN=MM3NDH
NAME=Nathan
QTH=Dalgety Bay
SQUARE=IO86ha

# UberSDR Configuration
# Use container name when on same Docker network (ubersdr_sdr-network)
# Use localhost or IP address if running outside Docker network
UBERSDR_HOST=172.20.0.1
UBERSDR_PORT=8080

# Reduced-depth IQ Compression (UberSDR driver)
# Trades a sliver of the receiver's own noise floor for a much smaller IQ stream.
# The value is a MARGIN in dB - how far below the band's noise floor the
# compression's own noise must stay - not a bit depth, so it means the same thing
# on a dead band as on a crowded one.
#   26      Default and measured-transparent (~0.01 dB noise floor penalty)
#   15-60   Lower = more compression, higher = less. No useful saving above ~40
#   0       Off - lossless, bit-exact IQ. Use for recording/archival or absolute
#           noise-floor measurements
# Anything else is refused by the driver, which then streams losslessly.
# Requires UberSDR 0.1.64 or later on the server; older servers ignore it.
MIN_MARGIN=26

# Frequency Calibration
# Adjust if your SDR has a frequency offset (in PPM)
# Default: 1 (no calibration)
FREQ_CALIBRATION=1

# Callsign Validation
# Minimum quality level for decoded callsigns (0-2)
# 0 = Minimal (accept more spots, may include false decodes)
# 1 = Normal (balanced)
# 2 = Strict (only high-confidence decodes)
# Default: 1
MIN_QUALITY=1

# Sample Rate
# 192 = 192 kHz - wider bandwidth per segment, higher CPU usage
# 96  = 96 kHz - half the CPU load, no loss of CW coverage for any band
SAMPLE_RATE=96

# RBN Spot Submission
# Set to false to stop sending spots to the Reverse Beacon Network
RBN_SEND_SPOTS=true

# RBN Aggregator Window Size
# Applied once each time the Aggregator window (re)appears, e.g. after a crash/restart.
# Feel free to resize the window manually via VNC afterwards - it won't be reset again
# until the Aggregator process itself restarts.
# Default: 1144x722
AGGREGATOR_WIDTH=1144
AGGREGATOR_HEIGHT=722

# Service Control
# Set to false to keep container running without starting CW Skimmer services
# Restart trigger watcher remains active for remote enable/disable
CWSKIMM_ENABLED=true

# RTTY Skimmer Server
# Set to true to enable RttySkimServ (disabled by default)
RTTYSKIRMSRV_ENABLED=false
# Telnet port for RttySkimServ (default: 7400; must not conflict with 7300/7301 used by CW SkimSrv)
RTTYSKIRMSRV_PORT=7400

# RTTY Band Selection
# Set to true/false to enable/disable each band for RttySkimServ
# Index mapping (CenterFreqs192): 0=160m 1=80m 2=60m 3=40m 4=30m 5=20m 6=17m 7=15m 8=12m 9=10m 10=10m(high)
RTTY_BAND_160M=false
RTTY_BAND_80M=false
RTTY_BAND_60M=false
RTTY_BAND_40M=true
RTTY_BAND_30M=false
RTTY_BAND_20M=true
RTTY_BAND_17M=false
RTTY_BAND_15M=false
RTTY_BAND_12M=false
RTTY_BAND_10M=false
RTTY_BAND_10M_HIGH=false

# RTTY Validation Level
# 0=minimal 1=normal 2=aggressive 3=paranoid
# Default: 2
RTTY_VALIDATION_LEVEL=2

# CW Band Selection
# Set to true/false to enable/disable each band
# Note: SkimSrv has an 8-band limit per instance
# - If you enable ≤8 bands: Only instance 1 runs with those bands
# - If you enable 9-16 bands: Instance 1 gets first 8, instance 2 gets remaining
# Both instances always run, but instance 2 will be idle if ≤8 bands enabled
# Anything beyond 16 enabled bands cannot be skimmed and is logged as a warning
#
BAND_160M=true
BAND_80M=true
BAND_60M=true
BAND_40M=true
BAND_30M=true
BAND_20M=true
BAND_17M=true
BAND_15M=true
BAND_12M=true
BAND_10M=true
BAND_10M_BEACONS=true
#
# NCDXF beacon segments — 96 kHz mode only.
#   BAND_20M_BEACONS: dedicated centre at 14.100 MHz
#   BAND_15M_BEACONS: dedicated centre at 21.150 MHz
# At 96 kHz a channel is only 91 kHz wide, so the 20m and 15m channels stop at
# 14.091 and 21.091 and cannot hear the NCDXF beacons — these two add a channel
# each that reaches them. Independent of BAND_20M/BAND_15M, and each costs a
# SkimSrv slot (eight per instance).
# KNOWN ISSUE: SkimSrv currently allocates no decoders to these two channels —
# they take a slot and produce no spots, so leave them false unless you are
# testing. The CwSegments entries they would need cannot be added without
# breaking every other band (see config/startup.sh).
# At 192 kHz the 182 kHz-wide 20m/15m channels already reach the beacons, and
# these two settings are ignored.
BAND_20M_BEACONS=false
BAND_15M_BEACONS=false
#
# 6m (50 MHz) — only works if your UberSDR can tune that high.
#   BAND_6M:         CW-only allocation, 50.000-50.100 MHz (all IARU regions).
#                    Includes the 50.060-50.080 Region 2 beacon sub-band and the
#                    50.090 CW DX calling frequency.
#   BAND_6M_BEACONS: IARU Region 1 beacon band, 50.400-50.500 MHz. Region 1
#                    (Europe/Africa/Middle East) only — leave false elsewhere.
#
# On startup the container reads tuning_range.max_frequency from the UberSDR
# API (/api/description) and automatically disables any band the receiver
# cannot reach, so enabling these on a 30 MHz instance is harmless — they are
# switched off with a log message rather than wasting a SkimSrv slot.
BAND_6M=false
BAND_6M_BEACONS=false
