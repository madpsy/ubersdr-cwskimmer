# CW Skimmer Docker Configuration
# Copy this file to .env and customize the values

# SkimSrv License
# To run SkimSrv as registered, export the Armadillo license blobs from a licensed
# Windows installation and place the .reg file(s) in the licenses/ directory.
# All *.reg files in that directory are automatically imported into Wine on startup.
# The licenses/ directory is bind-mounted read-only into the container.
# The licenses/ directory is gitignored so your license is never accidentally committed.

# Station Configuration
CALLSIGN=MM3NDH
NAME=Nathan
QTH=Dalgety Bay
SQUARE=IO86ha

# UberSDR Configuration
# Use container name when on same Docker network (ubersdr_sdr-network)
# Use localhost or IP address if running outside Docker network
UBERSDR_HOST=172.20.0.1
UBERSDR_PORT=8080

# Frequency Calibration
# Adjust if your SDR has a frequency offset (in PPM)
# Default: 1 (no calibration)
FREQ_CALIBRATION=1

# Callsign Validation
# Minimum quality level for decoded callsigns (0-2)
# 0 = Minimal (accept more spots, may include false decodes)
# 1 = Normal (balanced)
# 2 = Strict (only high-confidence decodes)
# Default: 0
MIN_QUALITY=0

# Sample Rate
# 192 = 192 kHz - wider bandwidth per segment, higher CPU usage
# 96  = 96 kHz - half the CPU load, no loss of CW coverage for any band
SAMPLE_RATE=96

# RBN Spot Submission
# Set to false to stop sending spots to the Reverse Beacon Network
RBN_SEND_SPOTS=true

# Service Control
# Set to false to keep container running without starting CW Skimmer services
# Restart trigger watcher remains active for remote enable/disable
CWSKIMM_ENABLED=true

# RTTY Skimmer Server
# Set to true to enable RttySkimServ (disabled by default)
RTTYSKIRMSRV_ENABLED=false
# Telnet port for RttySkimServ (default: 7400; must not conflict with 7300/7301 used by CW SkimSrv)
RTTYSKIRMSRV_PORT=7400

# RTTY Band Selection
# Set to true/false to enable/disable each band for RttySkimServ
# Index mapping (CenterFreqs192): 0=160m 1=80m 2=60m 3=40m 4=30m 5=20m 6=17m 7=15m 8=12m 9=10m 10=10m(high)
RTTY_BAND_160M=false
RTTY_BAND_80M=false
RTTY_BAND_60M=false
RTTY_BAND_40M=true
RTTY_BAND_30M=false
RTTY_BAND_20M=true
RTTY_BAND_17M=false
RTTY_BAND_15M=false
RTTY_BAND_12M=false
RTTY_BAND_10M=false
RTTY_BAND_10M_HIGH=false

# RTTY Validation Level
# 0=minimal 1=normal 2=aggressive 3=paranoid
# Default: 2
RTTY_VALIDATION_LEVEL=2

# CW Band Selection
# Set to true/false to enable/disable each band
# Note: SkimSrv has an 8-band limit per instance
# - If you enable ≤8 bands: Only instance 1 runs with those bands
# - If you enable 9-10 bands: Instance 1 gets first 8, instance 2 gets remaining
# Both instances always run, but instance 2 will be idle if ≤8 bands enabled
BAND_160M=true
BAND_80M=true
BAND_60M=true
BAND_40M=true
BAND_30M=true
BAND_20M=true
BAND_17M=true
BAND_15M=true
BAND_12M=true
BAND_10M=true
BAND_10M_BEACONS=true
